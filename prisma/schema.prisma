// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model PortfolioItems {
  id          Int                @id @default(autoincrement())
  name        String
  description String
  extendedDescription String?
  demoUrl     String
  type        String
  imageName   String?
  languages   PortfolioLanguages[]
  dirKey      String?
  githubUrl   String?
  month       String?
  year        String?
}

model Languages {
  id              Int                @id @default(autoincrement())
  name            String
  portfolioItems  PortfolioLanguages[]
}

model PortfolioLanguages {
  portfolioItemId Int
  languageId      Int

  portfolioItem   PortfolioItems @relation(fields: [portfolioItemId], references: [id])
  language        Languages      @relation(fields: [languageId], references: [id])

  @@id([portfolioItemId, languageId])
}

model EmailCounter {
  id  Int @id @default(autoincrement())
  count Int
}

model WorkExperience {
  id        Int     @id @default(autoincrement())
  name      String?
  imageKey  String?

  position  String
  type      String
  location  String
  remote    Boolean

  startPeriod Int
  endPeriod   Int?

  // Flattened self-relation representing `child?: ExperienceItemProps`
  parentId Int?             @unique
  parent   WorkExperience?  @relation("WorkExperienceChild", fields: [parentId], references: [id])
  child    WorkExperience?  @relation("WorkExperienceChild")

  bullets ExperienceBullet[]
}

model ExperienceBullet {
  id               Int            @id @default(autoincrement())
  text             String
  order            Int            @default(0)
  workExperienceId Int
  workExperience   WorkExperience @relation(fields: [workExperienceId], references: [id], onDelete: Cascade)
}
